{
	"$schema": "https://dprint.dev/schemas/v0.json",

	"lineWidth": 100,
	"useTabs": true,

	"typescript": {
		"quoteStyle": "preferDouble",
		"module.sortImportDeclarations": "maintain"
	},

	"markup": {
		"component.selfClosing": true
	},

	"excludes": [
		"CODE_OF_CONDUCT.md",
		"LICENSE.md",
		"SECURITY.md",
		".agents/skills/gh-stack/**",
		".agents/skills/ask-matt/**",
		".agents/skills/chief-of-staff/**",
		".agents/skills/claude-handoff/**",
		".agents/skills/code-review/**",
		".agents/skills/codebase-design/**",
		".agents/skills/diagnosing-bugs/**",
		".agents/skills/domain-modeling/**",
		".agents/skills/git-guardrails-claude-code/**",
		".agents/skills/grill-me/**",
		".agents/skills/grill-with-docs/**",
		".agents/skills/grilling/**",
		".agents/skills/handoff/**",
		".agents/skills/implement/**",
		".agents/skills/implement-spec/**",
		".agents/skills/improve-codebase-architecture/**",
		".agents/skills/loop-me/**",
		".agents/skills/migrate-to-shoehorn/**",
		".agents/skills/pr/**",
		".agents/skills/prototype/**",
		".agents/skills/research/**",
		".agents/skills/retro/**",
		".agents/skills/scaffold-exercises/**",
		".agents/skills/setup-matt-pocock-skills/**",
		".agents/skills/setup-pre-commit/**",
		".agents/skills/setup-ts-deep-modules/**",
		".agents/skills/tdd/**",
		".agents/skills/teach/**",
		".agents/skills/to-questionnaire/**",
		".agents/skills/to-spec/**",
		".agents/skills/to-tickets/**",
		".agents/skills/triage/**",
		".agents/skills/wait-what/**",
		".agents/skills/wayfinder/**",
		".agents/skills/wizard/**",
		".agents/skills/writing-beats/**",
		".agents/skills/writing-for-agents/**",
		".agents/skills/writing-fragments/**",
		".agents/skills/writing-shape/**",
		".hermes/skills/**",
		"**/.impeccable/hook.cache.json",
		"**/dist",
		"**/node_modules",
		"**/*-lock.json",
		"**/*.lock",
		"data/**",
		"evals/datasets/registry.json",
		"evals/datasets/v2/proposals/rust-async-await.md",
		"e2e/.scratch/**",
		"e2e/test-results/**",
		"e2e/playwright-report/**"
	],

	"plugins": [
		"https://github.com/dprint/dprint-plugin-typescript/releases/download/0.95.13/plugin.wasm",
		"https://github.com/dprint/dprint-plugin-json/releases/download/0.21.0/plugin.wasm",
		"https://github.com/dprint/dprint-plugin-markdown/releases/download/0.20.0/plugin.wasm",
		"https://github.com/g-plane/malva/releases/download/v0.16.0/plugin.wasm",
		"https://github.com/g-plane/markup_fmt/releases/download/v0.23.4/plugin.wasm"
	]
}
